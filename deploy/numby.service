[Unit]
Description=Numby phone and agent bridge
After=network-online.target
Wants=network-online.target
[Service]
User=numby
Group=numby
WorkingDirectory=/srv/numby/backend-current
EnvironmentFile=/etc/numby/backend.env
ExecStart=/opt/node/bin/node src/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/numby
MemoryMax=300M
TasksMax=64
[Install]
WantedBy=multi-user.target
